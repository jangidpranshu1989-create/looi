# ---- Mode ----
# 1 = hosted SaaS (accounts, plans, Looi AI included). Unset = single-user self-host (bring your own keys in Settings).
LOOI_SAAS=1
PORT=5000
# Public URL of this server (tracked links, OAuth callbacks, Instagram media). On Cloudflare it is learned from the first request.
LOOI_PUBLIC_URL=https://looi.example.com
LOOI_DATA_DIR=./looi-data
LOOI_DB=./data.db
# Parallel ad/audit jobs (paid plans are served first)
LOOI_WORKERS=2

# ---- Looi AI (house brain, users never need a key). NIM first, Groq takes over instantly on any failure. ----
GROQ_API_KEY=            # https://console.groq.com/keys
GROQ_MODEL=              # default: openai/gpt-oss-120b
NVIDIA_API_KEY=          # https://build.nvidia.com  (NVIDIA NIM)
NVIDIA_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
# Any OpenAI-compatible endpoint (Together, Fireworks, OpenRouter, vLLM, Ollama ...) - tried first
LOOI_AI_BASE_URL=
LOOI_AI_KEY=
LOOI_AI_MODEL=

# ---- Publishing plugins ----
COMPOSIO_API_KEY=        # https://platform.composio.dev

# ---- Audits ----
PSI_API_KEY=             # Google PageSpeed Insights key (fallback when local Lighthouse fails)
CHROME_PATH=             # auto-detected; /usr/bin/chromium in Docker

# ---- Freemium ----
LOOI_TRIAL_DAYS=7
LOOI_PRICE_PRO_INR=999
LOOI_PRICE_SCALE_INR=2999
ADMIN_EMAILS=you@example.com   # unlimited plan + /api/admin/*

# ---- Payments: UPI deep link / QR + UTR verification (admins approve in /app/admin) ----
LOOI_UPI_ID=8529418454@fam
LOOI_UPI_NAME=Looi
LOOI_PROVISIONAL_HOURS=48      # plan unlocks at UTR submit, reverted if the admin rejects

# ---- Support ----
LOOI_SUPPORT_EMAIL=jangid.pranshu1989@gmail.com
LOOI_SUPPORT_WHATSAPP=918529418454

# ---- AI failover ----
LOOI_AI_ORDER=custom,nvidia,groq,openai
LOOI_NIM_TIMEOUT_MS=45000      # NIM slower than this -> Groq answers instead
LOOI_AI_COOLDOWN_MS=180000     # a failing provider is skipped for this long

# ---- Durable storage on ephemeral hosts (set automatically on Cloudflare) ----
LOOI_R2_URL=
LOOI_R2_TOKEN=
LOOI_BACKUP_SEC=60
